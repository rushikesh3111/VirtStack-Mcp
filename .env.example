# VirtStack backend URL — change to your VirtStack server address
VIRTSTACK_API_URL=http://localhost:8000

# VirtStack login credentials (used for auto-login; stored in memory only)
VIRTSTACK_USERNAME=admin
VIRTSTACK_PASSWORD=your_password_here

# MCP server transport: "stdio" for Claude Desktop, "sse" for OpenWebUI
MCP_TRANSPORT=sse

# Port for FastAPI web interface (Swagger UI at http://localhost:8080/docs)
API_PORT=8080
